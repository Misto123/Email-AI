{
  "name": "email-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Human-approved AI email drafts for Purelymail inboxes",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cloudflare:dev": "opennextjs-cloudflare build && wrangler dev",
    "cloudflare:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/postgres": "^0.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.0.0",
    "imapflow": "^1.7.7",
    "lucide-react": "^1.6.0",
    "next": "^16.2.11",
    "nodemailer": "^9.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-intersection-observer": "^11.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  }
}
