# ======================================
# MODEL ROUTER CONFIGURATION
# ======================================
# Copy this file to .env.local and fill in your API keys

# ---- OpenRouter API ----
# Get your API key from: https://openrouter.ai/keys
# Supports: Claude, GPT-5.6 Luna, GPT-4, and more
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ---- Router Strategy ----
# Options: cost-optimized | quality-first | balanced
# - cost-optimized: Use Luna for simple tasks (94% savings)
# - quality-first: Use Claude for everything
# - balanced: Smart routing based on task complexity (recommended)
MODEL_ROUTER_STRATEGY=cost-optimized

# ---- Application Info ----
# Used for OpenRouter request tracking
NEXT_PUBLIC_APP_NAME=memorable-blog
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ======================================
# PRICING REFERENCE (for your info)
# ======================================
# 
# GPT-5.6 Luna (50% OFF):
#   Input:  $0.10 / 1M tokens → $0.05 after discount
#   Output: $0.60 / 1M tokens → $0.30 after discount
#   Average: ~$0.35 / 1M tokens
#
# Claude 3.5 Sonnet:
#   Input:  $3.00 / 1M tokens
#   Output: $15.00 / 1M tokens
#   Average: ~$9.00 / 1M tokens
#
# POTENTIAL SAVINGS:
# Simple task (1000 tokens): $0.0009 (Claude) → $0.00035 (Luna) = 61% savings
# 10,000 requests/month: $9.00 (Claude) → $3.50 (Luna) = $5.50 saved
# Annual savings: ~$66/year on simple tasks alone

# ======================================
# TASK ROUTING (automatically configured)
# ======================================
#
# USES LUNA (cost-optimized):
# ✓ SEO meta generation
# ✓ Comment moderation
# ✓ Data extraction
# ✓ Simple classification
#
# USES CLAUDE (quality-first):
# ✓ Blog content generation
# ✓ Code generation
# ✓ Complex analysis
# ✓ Creative writing
#
# See src/config/model-routes.json for full configuration

# ======================================
# OPTIONAL: DIRECT API KEYS
# ======================================
# If you prefer to use direct API access instead of OpenRouter
# Leave these empty if using OpenRouter

# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# ======================================
# DATABASE (from previous setup)
# ======================================
# Your existing database connection for blog/comments
POSTGRES_URL=your_neon_or_vercel_postgres_url_here
